# Application
APP_NAME=AI GitHub PR Intelligence
APP_ENV=development
LOG_LEVEL=INFO

# GitHub
GITHUB_TOKEN=
GITHUB_REPOSITORY_OWNER=pallets
GITHUB_REPOSITORY_NAME=flask

# Ollama - used in a later stage
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Project directories
DATA_DIRECTORY=data
MODEL_DIRECTORY=models
KNOWLEDGE_BASE_DIRECTORY=knowledge_base
EVALUATION_DIRECTORY=evaluation
LOG_DIRECTORY=logs

# Model paths
MERGE_OUTCOME_MODEL_PATH=models/merge_outcome/merge_outcome_contributor_neutral_rf.joblib
REPOSITORY_BENCHMARK_MODEL_PATH=models/merge_outcome/merge_outcome_repository_specific_rf.joblib
MERGE_DELAY_MODEL_PATH=models/merge_delay/merge_delay_model.joblib

# Behaviour
DEFAULT_DELAY_THRESHOLD_HOURS=48
RANDOM_SEED=42

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3

GITHUB_RETRY_BACKOFF_SECONDS=1
GITHUB_RATE_LIMIT_BUFFER_SECONDS=5
GITHUB_RATE_LIMIT_WAIT_ENABLED=true
GITHUB_DEFAULT_PAGE_SIZE=100
GITHUB_MAX_PAGES=100